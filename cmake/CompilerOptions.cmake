# Warnings, sanitizers and coverage flags for a target.
function(miniredis_set_options target)
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Wshadow -Wconversion)
    if(MINIREDIS_WARNINGS_AS_ERRORS)
        target_compile_options(${target} PRIVATE -Werror)
    endif()

    if(MINIREDIS_ENABLE_ASAN AND MINIREDIS_ENABLE_TSAN)
        message(FATAL_ERROR "ASan and TSan cannot be enabled together")
    endif()
    if(MINIREDIS_ENABLE_ASAN)
        target_compile_options(${target} PUBLIC -fsanitize=address,undefined -fno-omit-frame-pointer)
        target_link_options(${target} PUBLIC -fsanitize=address,undefined)
    endif()
    if(MINIREDIS_ENABLE_TSAN)
        target_compile_options(${target} PUBLIC -fsanitize=thread)
        target_link_options(${target} PUBLIC -fsanitize=thread)
    endif()
    if(MINIREDIS_ENABLE_COVERAGE)
        target_compile_options(${target} PUBLIC --coverage -O0 -g)
        target_link_options(${target} PUBLIC --coverage)
    endif()
endfunction()
